# Estas son variables de entorno del sistema operativo / de tu herramienta de arranque
# (IntelliJ run config, docker-compose, systemd, etc). Spring Boot no lee un archivo
# .env automaticamente; este archivo es solo referencia de qué variables existen.

# PostgreSQL (URL en formato JDBC, distinto del formato "postgresql://user:pass@host/db")
DATABASE_URL=jdbc:postgresql://localhost:5432/reservas_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT (minimo 32 caracteres, HS256 requiere 256 bits de clave)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+caracteres
JWT_EXPIRATION_MS=604800000

# CORS: origen exacto del frontend (Next.js dev server)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Puerto del backend (debe coincidir con NEXT_PUBLIC_API_URL del frontend)
SERVER_PORT=8080
